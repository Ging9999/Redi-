{
  "_comment": "Example .claude/settings.json wiring for the agent coordination hook. Copy the `hooks` and `env` blocks into your own settings.json. Adjust the absolute path to coordinator_hook.py. Matchers are CASE-SENSITIVE (spec section 3): `Edit|Write` matches the Edit and Write tools; `edit` would match nothing.",

  "env": {
    "COORD_URL": "http://127.0.0.1:8787",
    "COORD_TOKEN": "replace-with-your-shared-token",
    "COORD_MODE": "warn",
    "COORD_TIMEOUT": "0.5"
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/hook/coordinator_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/hook/coordinator_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/hook/coordinator_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/hook/coordinator_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/hook/coordinator_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
